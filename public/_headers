# Cloudflare / Netlify-style headers — long cache for hashed assets, fonts, images.
# HTML must revalidate.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

# WP media proxy (cf. _redirects /wp-uploads/* -> update.africtivistes.org).
# WP n'envoie pas de Cache-Control utilisable ; on force ici un cache long
# cote edge Netlify pour eliminer la latence WP (et les ERR_NETWORK_CHANGED
# lies a la lenteur de l'origine + saturation HTTP/2).
/wp-uploads/*
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=31536000
  X-Content-Type-Options: nosniff

# SSR pages: serve stale from CDN while revalidating in background.
# Reduces perceived latency from ~3.5s to near-instant on repeat visits.
/fr/*
  Cache-Control: public, s-maxage=300, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/en/*
  Cache-Control: public, s-maxage=300, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
