# Copier ce fichier en `.env` puis renseigner les valeurs.
# Le `.env` réel est ignoré par git (cf. .gitignore) et ne doit jamais être commité.

# WordPress MCP Server - Application Password Authentication
# Générer un Application Password dans WordPress Admin :
#   Users > Profile > Application Passwords > Add New
export WORDPRESS_USERNAME=""
export WORDPRESS_APP_PASSWORD=""

# Hôte de l'API REST WordPress (sans slash final)
# Ex. : https://exemple.tld
PUBLIC_WP_HOST=""

# Infomaniak Newsletter
PUBLIC_INFOMANIAK_NEWSLETTER_ACTION=""
PUBLIC_INFOMANIAK_NEWSLETTER_KEY=""
PUBLIC_INFOMANIAK_NEWSLETTER_WEBFORM_ID=""
