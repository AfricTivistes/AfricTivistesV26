---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import ThematiquePage from "@/components/thematique/ThematiquePage";
import { thematiques } from "@/data/thematiques";
import { fetchThematiques, fetchProjets, slimWpProjets } from "@/lib/wordpress";
import { t } from "@/lib/i18n";

const lang = "fr";
const data = thematiques["engagement"];

/* SSR : on resout la thematique WP correspondante puis on fetch ses projets.
   Donnees passees en props directes -- pas de window.__PRELOAD__, payload
   projets slim. */
const allThematiques = await fetchThematiques(lang).catch(() => []);
const title = t(data.titleKey, lang);
const matched = allThematiques.find(
  (th) => th.name.toLowerCase() === title.toLowerCase() || th.slug.includes(data.slug),
);
const matchedId = matched?.id;

const projetsRaw = matchedId
  ? await fetchProjets(100, matchedId).catch(() => [])
  : [];
const projetsFiltered = projetsRaw.filter((p) => !p.lang || p.lang === lang);
const initialProjets = slimWpProjets(projetsFiltered);
---
<BaseLayout lang={lang} mainClass="">
  <ThematiquePage
    client:idle
    lang={lang}
    data={data}
    initialThematiques={allThematiques}
    initialProjets={initialProjets}
    initialMatchedThematiqueId={matchedId}
  />
</BaseLayout>
