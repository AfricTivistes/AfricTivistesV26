---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import GradientHero from "@/components/GradientHero.astro";
import ProjectThemes from "@/components/ProjectThemes.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import InitiativesIntro from "@/components/initiatives/InitiativesIntro.astro";
import InitiativesProjectGrid from "@/components/initiatives/InitiativesProjectGrid";
import { fetchProjets, fetchThematiques, slimWpProjets } from "@/lib/wordpress";

const lang = "fr";

/* Server-side prefetch en parallele.
   Donnees passees en props directes a InitiativesProjectGrid -- plus de
   window.__PRELOAD__ inline, payload projets slim. */
const [thematiques, projetsRaw] = await Promise.all([
  fetchThematiques(lang).catch(() => []),
  fetchProjets(100).catch(() => []),
]);
const projetsFiltered = projetsRaw.filter((p) => !p.lang || p.lang === lang);
const projetsSlim = slimWpProjets(projetsFiltered);
---
<BaseLayout lang={lang}>
  <GradientHero
    lang={lang}
    titleKey="programmes.title"
    subtitleKey="programmes.subtitle"
  />
  <InitiativesIntro lang={lang} />
  <ProjectThemes
    lang={lang}
    titleKey="initiatives.themesTitle"
    labelKey="initiatives.themesLabel"
    subtitleKey="initiatives.themesSubtitle"
    className="bg-muted/30"
    ctaCard={{
      titleKey: "projectThemes.joinNetwork.title",
      descKey: "projectThemes.joinNetwork.desc",
      ctaKey: "projectThemes.joinNetwork.cta",
      to: "/about/join",
    }}
  />
  <InitiativesProjectGrid
    client:idle
    lang={lang}
    initialProjets={projetsSlim}
    initialThematiques={thematiques}
  />
  <CtaBanner
    lang={lang}
    titleKey="about.ctaTitle"
    descKey="about.ctaDesc"
    btnKey="about.ctaBtn"
    linkTo="/contact"
    showDecoShapes
  />
</BaseLayout>
