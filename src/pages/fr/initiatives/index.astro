---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import GradientHero from "@/components/GradientHero.astro";
import ProjectThemes from "@/components/ProjectThemes.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import InitiativesIntro from "@/components/initiatives/InitiativesIntro.astro";
import InitiativesProjectGrid from "@/components/initiatives/InitiativesProjectGrid";
import { fetchProjets, fetchThematiques } from "@/lib/wordpress";

const lang = "fr";

const [thematiques, projets] = await Promise.all([
  fetchThematiques(lang).catch(() => []),
  fetchProjets(100).catch(() => []),
]);
const projetsFiltered = projets.filter((p) => !p.lang || p.lang === lang);

const preload = [
  { key: ["thematiques", lang], data: thematiques },
  { key: ["projets", lang, 100, undefined], data: projetsFiltered },
];
---
<BaseLayout lang={lang}>
  <script is:inline define:vars={{ preload }}>
    window.__PRELOAD__ = preload;
  </script>

  <GradientHero
    lang={lang}
    titleKey="programmes.title"
    subtitleKey="programmes.subtitle"
  />
  <InitiativesIntro lang={lang} />
  <ProjectThemes
    lang={lang}
    titleKey="initiatives.themesTitle"
    labelKey="initiatives.themesLabel"
    subtitleKey="initiatives.themesSubtitle"
    className="bg-muted/30"
    ctaCard={{
      titleKey: "projectThemes.joinNetwork.title",
      descKey: "projectThemes.joinNetwork.desc",
      ctaKey: "projectThemes.joinNetwork.cta",
      to: "/about/join",
    }}
  />
  <InitiativesProjectGrid lang={lang} client:idle />
  <CtaBanner
    lang={lang}
    titleKey="about.ctaTitle"
    descKey="about.ctaDesc"
    btnKey="about.ctaBtn"
    linkTo="/contact"
    showDecoShapes
  />
</BaseLayout>
