---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import ValuesHero from "@/components/values/ValuesHero.astro";
import ValuesIntro from "@/components/values/ValuesIntro.astro";
import ValuesCore from "@/components/values/ValuesCore.astro";
import ValuesPrinciples from "@/components/values/ValuesPrinciples.astro";
import ValuesGallery from "@/components/values/ValuesGallery.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import { extractImages } from "@/lib/i18n";
import valuesData from "@/data/translations/values.json";
const lang = "fr";
const imgs = extractImages(valuesData);
const heroImage = imgs._img_heroImage;
---
<BaseLayout lang={lang} preloadImage={heroImage}>
  <ValuesHero lang={lang} />
  <ValuesIntro lang={lang} />
  <ValuesCore lang={lang} />
  <ValuesPrinciples lang={lang} />
  <CtaBanner
    lang={lang}
    titleKey="values.ctaTitle"
    descKey="values.ctaDesc"
    btnKey="values.ctaBtn"
    linkTo="/contact"
    showDecoShapes
  />
</BaseLayout>
