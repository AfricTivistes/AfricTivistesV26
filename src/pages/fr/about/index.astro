---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import TwoColumnTextImage from "@/components/TwoColumnTextImage.astro";
import AboutApproach from "@/components/about/AboutApproach.astro";
import AboutGallery from "@/components/about/AboutGallery.astro";
import ValuesQuote from "@/components/values/ValuesQuote.astro";
import AboutValues from "@/components/about/AboutValues.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import BadgeStat from "@/components/BadgeStat.astro";
import { t, extractImages } from "@/lib/i18n";
import aboutData from "@/data/translations/about.json";
const lang = "fr";
const imgs = extractImages(aboutData);
const heroImage = imgs._img_heroImage;
const yearsEngagement = new Date().getFullYear() - 2015 - 1;
---

<BaseLayout lang={lang} preloadImage={heroImage}>
  <PageHero
    lang={lang}
    backgroundImage={imgs._img_heroImage}
    labelKey="nav.about"
    titleKey="about.title"
    subtitleKey="about.subtitle"
  />
  <TwoColumnTextImage
    lang={lang}
    labelKey="about.missionTitle"
    titleKey="about.missionSubtitle1"
    highlightKey="about.missionHighlight"
    descriptions={["about.mission1", "about.mission2"]}
    imageUrl={imgs._img_heroImage}
    imageAlt="AfricTivistes en action"
  >
    <BadgeStat
      slot="badge"
      lang={lang}
      value={`${yearsEngagement}+`}
      labelKey="about.yearsBadge"
      position="absolute -top-6 -right-6"
    />
  </TwoColumnTextImage>
  <AboutApproach lang={lang} />
  <AboutGallery lang={lang} />
  <ValuesQuote lang={lang} />
  <AboutValues lang={lang} />
  <CtaBanner
    lang={lang}
    titleKey="about.ctaTitle"
    descKey="about.ctaDesc"
    btnKey="about.ctaBtn"
    linkTo="/contact"
  />
</BaseLayout>
