---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import TwoColumnTextImage from "@/components/TwoColumnTextImage.astro";
import HistoryTimeline from "@/components/history/HistoryTimeline.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import historyData from "@/data/translations/history.json";
const lang = "fr";
const heroImage = historyData._img_heroImage;
---
<BaseLayout lang={lang} preloadImage={heroImage}>
  
    <PageHero
      lang={lang}
      backgroundImage={historyData._img_heroImage}
      labelKey="nav.about.history"
      titleKey="history.title"
      subtitleKey="history.subtitle"
    />
    <TwoColumnTextImage
      lang={lang}
      labelKey="history.originLabel"
      titleKey="history.originTitle1"
      highlightKey="history.originHighlight"
      descriptions={["history.originDesc1", "history.originDesc2"]}
      imageUrl={historyData._img_originImage}
      imageAlt="Fondation d'AfricTivistes"
    />
    <HistoryTimeline lang={lang} />
    <TwoColumnTextImage
      lang={lang}
      labelKey="history.visionLabel"
      titleKey="history.visionTitle"
      descriptions={["history.visionDesc"]}
      imageUrl={historyData._img_visionImage}
      imageAlt="Vision AfricTivistes"
      imagePosition="left"
      sectionBg="bg-muted/50"
    />
    <CtaBanner
      lang={lang}
      titleKey="history.ctaTitle"
      descKey="history.ctaDesc"
      btnKey="history.ctaBtn"
      linkTo="/contact"
    />
  
</BaseLayout>
