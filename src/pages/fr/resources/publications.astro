---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResourcesPublications from "@/components/resources/ResourcesPublications";
import { fetchPosts, PUBLICATION_CATEGORY_IDS } from "@/lib/wordpress";

const lang = "fr";
const pubCatId = PUBLICATION_CATEGORY_IDS[lang] || PUBLICATION_CATEGORY_IDS.fr;

const postsData = await fetchPosts({
  page: 1,
  perPage: 9,
  categories: [pubCatId],
  lang,
}).catch(() => ({ posts: [], totalPages: 1, total: 0 }));

const preload = [
  {
    key: ["posts", { page: 1, perPage: 9, categories: [pubCatId], categoriesExclude: undefined, search: undefined, lang }],
    data: postsData,
  },
];
---
<BaseLayout lang={lang}>
  <script is:inline define:vars={{ preload }}>
    window.__PRELOAD__ = preload;
  </script>
  <ResourcesPublications lang={lang} client:load />
</BaseLayout>
