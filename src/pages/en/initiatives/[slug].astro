---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjetDetail from "@/components/projet/ProjetDetail";
import {
  fetchProjetBySlugWithLang,
  fetchProjets,
  fetchPlateformesByIds,
  fetchPartenairesByIds,
  fetchProjetMeres,
  fetchPosts,
  getOgImageUrl,
  stripHtml,
  collectPhases,
  slimWpProjets,
  slimWpPosts,
  type WPProjet,
} from "@/lib/wordpress";

const lang = "en";
const { slug } = Astro.params;

/* SSR : on fetch le projet, puis on lance en parallele toutes les sous-ressources
   (similaires, plateformes, partenaires, projets meres). Donnees passees en props
   directes -- plus de window.__PRELOAD__ inline. */
let projet = null;
try {
  projet = await fetchProjetBySlugWithLang(slug, lang);
} catch (err) {
  console.error("[ProjetDetail SSR prefetch] failed:", err);
}

let initialSimilarProjets: WPProjet[] | undefined;
let initialPlateformes: Awaited<ReturnType<typeof fetchPlateformesByIds>> | undefined;
let initialPartenaires: Awaited<ReturnType<typeof fetchPartenairesByIds>> | undefined;
let initialProjetsMeres: Awaited<ReturnType<typeof fetchProjetMeres>> | undefined;
let initialRelatedPosts: Awaited<ReturnType<typeof fetchPosts>> | undefined;

if (projet) {
  const thematiqueId = projet.thematique?.[0];
  const plateformeIds = projet.acf?.plateformes_projet || [];
  const projetMereIds = projet.projet_mere || [];

  const phases = collectPhases(projet.acf);
  const phasePartenaireIds = new Set<number>();
  phases.forEach((ph) => ph.phase_partenaires?.forEach((id) => phasePartenaireIds.add(id)));
  const allPartenaireIds = [
    ...new Set([
      ...phasePartenaireIds,
      ...(projet.acf?.soutenu_par || []),
      ...(projet.acf?.en_partenariat_avec || []),
    ]),
  ];

  const [similarRaw, plateformes, partenaires, projetsMeres] = await Promise.all([
    thematiqueId
      ? fetchProjets(5, thematiqueId).catch(() => [])
      : Promise.resolve([]),
    plateformeIds.length
      ? fetchPlateformesByIds(plateformeIds).catch(() => [])
      : Promise.resolve([]),
    allPartenaireIds.length
      ? fetchPartenairesByIds(allPartenaireIds).catch(() => [])
      : Promise.resolve([]),
    projetMereIds.length
      ? fetchProjetMeres(projetMereIds).catch(() => [])
      : Promise.resolve([]),
  ]);

  /* Cast en WPProjet[] : slimWpProjets retire excerpt/content (non lus par
     SimilarProjetsSection : seuls id/slug/title/_embedded sont consommes),
     donc la donnee est structurellement compatible. */
  const similarFiltered = similarRaw.filter((p) => !p.lang || p.lang === lang);
  initialSimilarProjets = slimWpProjets(similarFiltered) as WPProjet[];
  initialPlateformes = plateformes;
  initialPartenaires = partenaires;
  initialProjetsMeres = projetsMeres;

  /* Contenus liés : articles/publications dont le champ ACF `initiatives`
     contient ce projet (filtre REST ?related_projet=). */
  const related = await fetchPosts({ perPage: 6, relatedProjet: projet.id }).catch(
    () => ({ posts: [], totalPages: 1, total: 0 }),
  );
  initialRelatedPosts = { ...related, posts: slimWpPosts(related.posts) };
}

const ogTitle = projet ? `${stripHtml(projet.title.rendered)} | AfricTivistes` : undefined;
const ogDescription = projet?.excerpt?.rendered ? stripHtml(projet.excerpt.rendered).slice(0, 200) : undefined;
const ogImage = projet ? getOgImageUrl(projet) ?? undefined : undefined;
---
<BaseLayout
  lang={lang}
  mainClass=""
  title={ogTitle}
  description={ogDescription}
  ogImage={ogImage}
>
  <ProjetDetail
    client:idle
    lang={lang}
    slug={slug}
    initialProjet={projet}
    initialSimilarProjets={initialSimilarProjets}
    initialPlateformes={initialPlateformes}
    initialPartenaires={initialPartenaires}
    initialProjetsMeres={initialProjetsMeres}
    initialRelatedPosts={initialRelatedPosts}
  />
</BaseLayout>
