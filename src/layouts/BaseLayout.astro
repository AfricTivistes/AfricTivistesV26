---
import "@/index.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "@/components/Navbar";
import Footer from "@/components/Footer.astro";

type ImageMime = "image/avif" | "image/webp" | "image/jpeg" | "image/png" | "image/svg+xml";

interface Props {
  title?: string;
  description?: string;
  lang?: "fr" | "en";
  mainClass?: string;
  /** URL of the hero image to preload (per-page LCP optimisation). */
  preloadImage?: string;
  /** Override MIME type detection if needed. */
  preloadImageType?: ImageMime;
  /** Optional `imagesrcset` for responsive preload (P2 — hero multi-size). */
  preloadImageSrcset?: string;
  /** Optional `imagesizes` paired with `preloadImageSrcset`. */
  preloadImageSizes?: string;
  /** Canonical URL for this page (defaults to current URL). */
  canonical?: string;
  /** OG image URL (defaults to preloadImage if it's a JPG/WebP/PNG, else fallback). */
  ogImage?: string;
  /** Override og:type (defaults to "website", use "article" for blog posts). */
  ogType?: "website" | "article";
  /** Defer GTM (ms) — only used if a GTM_ID is configured. */
  deferGtmMs?: number;
}

const {
  title = "AfricTivistes - Ligue des Cybercitoyens Africains",
  description = "AfricTivistes est une organisation panafricaine de civic tech qui promeut la démocratie numérique en Afrique.",
  lang = "fr",
  mainClass = "pt-24 pb-20",
  preloadImage,
  preloadImageType,
  preloadImageSrcset,
  preloadImageSizes,
  canonical,
  ogImage,
  ogType = "website",
  deferGtmMs = 2000,
} = Astro.props;

const GTM_ID = import.meta.env.PUBLIC_GTM_ID; // optional

// MIME detection from extension (skill: auto-detect)
function detectMime(url: string): ImageMime | undefined {
  const u = url.split("?")[0].toLowerCase();
  if (u.endsWith(".avif")) return "image/avif";
  if (u.endsWith(".webp")) return "image/webp";
  if (u.endsWith(".jpg") || u.endsWith(".jpeg")) return "image/jpeg";
  if (u.endsWith(".png")) return "image/png";
  if (u.endsWith(".svg")) return "image/svg+xml";
  return undefined;
}

const preloadType = preloadImage ? (preloadImageType ?? detectMime(preloadImage)) : undefined;

const canonicalUrl = canonical ?? Astro.url.href;

// Pick a sensible OG image: explicit > preload (if raster) > generic logo
function pickOgImage(): string {
  if (ogImage) return ogImage;
  return "/og-default.jpg"; // ensure this exists in /public; falls back gracefully if missing
}
const ogImageUrl = pickOgImage();
const isDefaultOg = ogImageUrl === "/og-default.jpg";

// Ensure OG image is always an absolute URL (required by social platforms)
const siteOrigin = (Astro.site ?? Astro.url).origin;
const ogImageAbsolute = ogImageUrl.startsWith("http") ? ogImageUrl : `${siteOrigin}${ogImageUrl}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="AfricTivistes" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* LCP image preload — must be before any non-essential resources.
        Supports both single URL and responsive `imagesrcset` (P2). */}
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSizes}
        type={preloadType}
        fetchpriority="high"
      />
    )}

    {/* Background image globale (body::before). Preload low-priority pour
        eviter un flash blanc sans concurrencer le LCP. Note : bg.webp est
        en realite encode en JPEG, d'ou type="image/jpeg". */}
    <link rel="preload" as="image" href="/bg.webp" type="image/jpeg" fetchpriority="low" />

    {/* Preconnect to WordPress media CDN (used by most subpages) */}
    <link rel="preconnect" href="https://update.africtivistes.org" crossorigin />
    <link rel="dns-prefetch" href="https://update.africtivistes.org" />

    {/* Self-hosted fonts (P2) : evite 2 RTT vers fonts.googleapis.com +
        fonts.gstatic.com + le download du CSS bloquant. Les .woff2 sont des
        variable fonts (un seul fichier couvre 400-700 / 500-700 via l'axe wght).
        Preload uniquement le subset latin critique (used by FR/EN visible text);
        latin-ext est lazy via unicode-range. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Plus Jakarta Sans';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/plus-jakarta-sans-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Plus Jakarta Sans';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/plus-jakarta-sans-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 500 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 500 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
    </style>

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbsolute} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@AfricTivistes" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    {/* hreflang alternates */}
    <link rel="alternate" hreflang="fr" href={new URL(Astro.url.pathname.replace(/^\/(en|fr)\//, "/fr/"), Astro.site ?? Astro.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname.replace(/^\/(en|fr)\//, "/en/"), Astro.site ?? Astro.url).href} />

    {/* Prefetch the alternate-language version of this page so the language
        switch is instant. The browser keeps it in cache; ClientRouter reuses it. */}
    <link
      rel="prefetch"
      href={Astro.url.pathname.startsWith("/en")
        ? Astro.url.pathname.replace(/^\/en/, "/fr") + Astro.url.search
        : Astro.url.pathname.replace(/^\/fr/, "/en") + Astro.url.search}
    />

    {/* View Transitions: instant client-side navigation between Astro pages.
        Combined with prefetch (configured in astro.config.mjs) this makes
        intra-site navigation feel instantaneous. */}
    <ClientRouter fallback="swap" />

    {/* GTM (deferred) — only injected if GTM ID is configured */}
    {GTM_ID && (
      <script is:inline define:vars={{ GTM_ID, deferGtmMs }}>
        {`
          window.dataLayer = window.dataLayer || [];
          setTimeout(function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
            document.head.appendChild(s);
            window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          }, deferGtmMs);
        `}
      </script>
    )}

    {/* Netlify Identity widget — required for Decap CMS login.
        `defer` makes it non-render-blocking : le browser continue de parser
        le HTML sans attendre le download du widget (~30KB). Le script inline
        en fin de body utilise DOMContentLoaded pour attendre que le widget
        soit pret avant de s'enregistrer aux events. */}
    <script is:inline defer src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <!-- Netlify Forms – hidden forms for build-time detection -->
    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input type="hidden" name="form-name" value="contact" />
      <input type="text" name="bot-field" />
      <input type="text" name="name" />
      <input type="email" name="email" />
      <input type="text" name="subject" />
      <textarea name="message"></textarea>
    </form>
    <form name="join" method="POST" data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input type="hidden" name="form-name" value="join" />
      <input type="text" name="bot-field" />
      <input type="text" name="member-type" />
      <input type="text" name="firstname" />
      <input type="text" name="lastname" />
      <input type="text" name="orgname" />
      <input type="email" name="email" />
      <input type="text" name="country" />
      <textarea name="motivation"></textarea>
    </form>

    <div class="min-h-screen">
      <a href="#main-content" class="skip-to-content">
        {lang === "fr" ? "Aller au contenu principal" : "Skip to main content"}
      </a>
      {/* Navbar hydrate au idle (vs client:load) : le SSR rend la barre
          immediatement avec ses liens fonctionnels, l'interactivite React
          (dropdowns, menu mobile) s'active apres le first paint. Evite de
          charger React DOM (~44KB gz) sur le critical path. */}
      <Navbar lang={lang} client:idle transition:persist transition:name="site-navbar" />
      <main id="main-content" class={mainClass}>
        <slot />
      </main>
      <Footer lang={lang} transition:persist transition:name="site-footer" />
    </div>

    {/* Global IntersectionObserver: any element with `.a-reveal` fades in once visible.
        Re-runs after every Astro view transition so newly-swapped content animates too. */}
    <script is:inline>
      (function () {
        if (typeof window === "undefined") return;
        function arm() {
          var els = document.querySelectorAll(".a-reveal, .a-reveal-left, .a-reveal-right, .a-reveal-scale");
          if (!els.length) return;
          if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) {
            els.forEach(function (el) { el.classList.add("in-view"); });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("in-view");
                io.unobserve(e.target);
              }
            });
          }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });
          els.forEach(function (el) {
            if (el.classList.contains("in-view")) return;
            var rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) {
              el.classList.add("in-view");
            } else {
              io.observe(el);
            }
          });
        }
        arm();
        document.addEventListener("astro:page-load", arm);
      })();
    </script>

    {/* Netlify Identity: redirect to /admin/ after login.
        Wrappe dans DOMContentLoaded car le widget (defer dans <head>) n'est
        pas encore charge au moment du parse de ce script. */}
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.netlifyIdentity) {
          window.netlifyIdentity.on("init", function (user) {
            if (!user) {
              window.netlifyIdentity.on("login", function () {
                document.location.href = "/admin/";
              });
            }
          });
        }
      });
    </script>
  </body>
</html>
