---
import PageHero from "@/components/PageHero.astro";
import { t, extractImages, type Lang } from "@/lib/i18n";
import joinData from "@/data/translations/join.json";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const imgs = extractImages(joinData);
---
<PageHero
  lang={lang}
  backgroundImage={imgs._img_heroImage}
  labelKey="nav.about.join"
  titleKey="join.title"
  subtitleKey="join.subtitle"
>
  <div class="a-fade mt-8" style="--a-delay:300ms">
    <a
      href="#formulaire"
      class="inline-flex items-center gap-2 rounded-lg bg-secondary px-8 py-3.5 text-sm font-bold text-secondary-foreground hover:bg-secondary/90 transition-colors focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2"
    >
      {t("join.submit", lang)}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</PageHero>
