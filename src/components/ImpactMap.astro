---
import Reveal from "@/components/astro/Reveal.astro";
import { t, type Lang } from "@/lib/i18n";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const yearsExistence = new Date().getFullYear() - 2015 - 1;

const impactItems = [
  { value: `+${yearsExistence}`, labelKey: "about.yearsExistence" },
  { value: "+2 000",  labelKey: "about.stat.benefPresential" },
  { value: "7 858",   labelKey: "about.stat.benefOnline" },
  { value: "+1 283",  labelKey: "about.stat.participants" },
  { value: "15",      labelKey: "about.stat.elections" },
  { value: "32",      labelKey: "about.stat.communities" },
  { value: "+30",     labelKey: "about.stat.youth" },
  { value: "+25",     labelKey: "about.stat.civicTech" },
  { value: "11",      labelKey: "about.stat.activists" },
  { value: "7",       labelKey: "about.stat.awards" },
  { value: "420 000 €", labelKey: "about.stat.grants" },
  { value: "7",       labelKey: "about.stat.technical" },
  { value: "+25",     labelKey: "about.stat.research" },
  { value: "3",       labelKey: "about.stat.elearning" },
];

const milestones = [
  { year: "2015", eventKey: "about.milestone2015" },
  { year: "2017", eventKey: "about.milestone2017" },
  { year: "2019", eventKey: "about.milestone2019" },
  { year: "2021", eventKey: "about.milestone2021" },
  { year: "2023", eventKey: "about.milestone2023" },
];
---
<section class="py-24 overflow-hidden">
  <div class="section-container">
    <Reveal class="text-center mb-16">
      <span class="text-sm font-semibold text-primary uppercase tracking-wider">{t("about.impactLabel", lang)}</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-foreground mt-2">
        {t("about.impactTitle", lang)}
      </h2>
      <div class="w-20 h-1 bg-secondary mx-auto mt-4 rounded-full"></div>
    </Reveal>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-16">
      {impactItems.map((item, i) => (
        <Reveal variant="scale" delay={i * 50} class="bg-card rounded-xl p-6 border border-border text-center hover:shadow-lg hover:border-primary/20 transition-all">
          <div class="text-3xl lg:text-4xl font-heading font-bold text-primary mb-2">
            {item.value}
          </div>
          <div class="text-xs text-muted-foreground font-medium leading-snug">{t(item.labelKey, lang)}</div>
        </Reveal>
      ))}
    </div>

    <div class="relative max-w-3xl mx-auto">
      <div class="absolute left-4 lg:left-1/2 top-0 bottom-0 w-px bg-border lg:-translate-x-px"></div>
      {milestones.map((m, i) => (
        <Reveal variant={i % 2 === 0 ? "left" : "right"} delay={i * 100} class={`relative flex items-start gap-6 mb-10 ${i % 2 === 0 ? "lg:flex-row" : "lg:flex-row-reverse"} flex-row`}>
          <div class="hidden lg:block lg:w-1/2"></div>
          <div class="absolute left-4 lg:left-1/2 w-4 h-4 rounded-full bg-primary border-[3px] border-background -translate-x-2 lg:-translate-x-2 mt-1 z-10 shadow-md"></div>
          <div class="pl-10 lg:pl-0 lg:w-1/2">
            <span class="inline-block text-xs font-bold text-white bg-secondary px-2.5 py-0.5 rounded-full">{m.year}</span>
            <p class="text-sm text-foreground mt-2 leading-relaxed">{t(m.eventKey, lang)}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>
