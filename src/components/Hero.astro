---
import HeroCarousel from "@/components/HeroCarousel";
import { t, type Lang } from "@/lib/i18n";
import {
  getFeaturedImageUrl,
  getPostCategories,
  stripHtml,
  formatDate,
  type WPPost,
} from "@/lib/wordpress";
import { getHeroImageVariants } from "@/lib/hero-image";

interface Props {
  lang: Lang;
  posts: WPPost[];
}

const { lang, posts } = Astro.props;

/* P2 : responsive multi-size hero (640/1024/1920) genere a partir de
   hero-bg.jpg via astro:assets. AVIF -> WebP -> JPG fallback. Mobile
   telecharge ~25KB AVIF au lieu des 86KB de la version 1920w. */
const hero = await getHeroImageVariants();

const arrowRightPath = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>';
const bookOpenPath = '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>';

const dateLocale = lang === "en" ? "en-US" : "fr-FR";
const featured = posts[0];
const featuredImg = featured ? getFeaturedImageUrl(featured) : null;
const featuredCats = featured ? getPostCategories(featured) : [];
const featuredTitle = featured ? stripHtml(featured.title.rendered) : "";

const prevLabel = lang === "fr" ? "Article précédent" : "Previous article";
const nextLabel = lang === "fr" ? "Article suivant" : "Next article";
const goToLabel = lang === "fr" ? "Aller à l'article" : "Go to article";
const initiativesLabel = lang === "fr"
  ? "Découvrir nos initiatives et projets"
  : "Discover our initiatives and projects";
const newsLabel = lang === "fr"
  ? "Lire nos dernières actualités"
  : "Read our latest news";
const sectionLabel = lang === "fr" ? "Section d'accueil" : "Home section";
---
<section class="relative min-h-[90vh] flex items-center overflow-hidden" aria-label={sectionLabel}>
  {/* Background */}
  <div class="absolute inset-0" aria-hidden="true">
    <picture>
      <source srcset={hero.avifSrcset} sizes={hero.sizes} type="image/avif" />
      <source srcset={hero.webpSrcset} sizes={hero.sizes} type="image/webp" />
      <img
        src={hero.fallbackSrc}
        srcset={hero.jpgSrcset}
        sizes={hero.sizes}
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width={hero.width}
        height={hero.height}
      />
    </picture>
    <div class="absolute inset-0 hero-gradient opacity-90"></div>
    <div class="absolute inset-0 pattern-african"></div>
  </div>

  {/* Contenu split */}
  <div class="relative section-container py-20 lg:py-28 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

      {/* Gauche -- Texte (statique SSR) */}
      <div class="a-reveal">
        <span class="inline-block px-4 py-1.5 rounded-full bg-secondary/20 text-secondary text-sm font-semibold mb-6 backdrop-blur-sm border border-secondary/30">
          {t("hero.badge", lang)}
        </span>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-primary-foreground leading-[1.1] mb-6">
          {t("hero.title1", lang)}
          <span class="text-gradient-gold">{t("hero.highlight", lang)}</span>
          {t("hero.title2", lang)}
        </h1>

        <p class="text-base sm:text-lg text-primary-foreground/80 mb-8 max-w-xl leading-relaxed">
          {t("hero.desc", lang)}
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={`/${lang}/initiatives`}
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-secondary px-7 py-3.5 text-base font-bold text-secondary-foreground hover:bg-secondary/90 transition-all hover:scale-[1.02] shadow-lg focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2"
            aria-label={initiativesLabel}
          >
            {t("hero.cta1", lang)}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowRightPath}></svg>
          </a>
          <a
            href={`/${lang}/blog`}
            class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-primary-foreground/30 bg-primary-foreground/10 px-7 py-3.5 text-base font-semibold text-primary-foreground hover:bg-primary-foreground/20 transition-all backdrop-blur-sm focus:outline-none focus:ring-2 focus:ring-primary-foreground focus:ring-offset-2"
            aria-label={newsLabel}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={bookOpenPath}></svg>
            {t("hero.cta2", lang)}
          </a>
        </div>
      </div>

      {/* Droite -- Carrousel articles a la une.
          Astro pre-rend la 1ere slide en HTML statique (zero skeleton).
          L'island HeroCarousel hydrate (client:idle) pour activer
          l'auto-rotation + la navigation manuelle. */}
      <div class="relative hidden lg:block">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl aspect-[4/3] bg-foreground/10 backdrop-blur-sm border border-white/10">
          {posts.length > 0 ? (
            <HeroCarousel
              client:idle
              posts={posts}
              lang={lang}
              prevLabel={prevLabel}
              nextLabel={nextLabel}
              goToLabel={goToLabel}
            />
          ) : (
            /* Fallback si aucun article */
            <div class="w-full h-full flex items-center justify-center">
              <img
                src={hero.fallbackSrc}
                alt=""
                class="w-full h-full object-cover opacity-60"
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
            </div>
          )}
        </div>
      </div>

    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-background to-transparent"></div>
</section>
