---
import Reveal from "@/components/astro/Reveal.astro";
import valuesData from "@/data/translations/values.json";

const galleryItems = [
  { src: valuesData._img_galleryImage1, span: "md:col-span-2 md:row-span-2" },
  { src: valuesData._img_galleryImage2, span: "" },
  { src: valuesData._img_galleryImage3, span: "" },
  { src: valuesData._img_galleryImage4, span: "md:col-span-2" },
];
---
<section class="py-12 lg:py-16">
  <div class="section-container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 lg:gap-4">
      {galleryItems.map((img, i) => (
        <Reveal variant="scale" delay={i * 80} class={`relative rounded-xl overflow-hidden group ${img.span}`}>
          <img
            src={img.src}
            alt=""
            class={`w-full object-cover group-hover:scale-105 transition-transform duration-700 ${i === 0 ? "h-48 md:h-full" : "h-48 md:h-56"}`}
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        </Reveal>
      ))}
    </div>
  </div>
</section>
