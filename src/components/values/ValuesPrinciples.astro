---
import Reveal from "@/components/astro/Reveal.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { t, type Lang } from "@/lib/i18n";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const principles = [
  { icon: "scale",     titleKey: "values.principle1Title", descKey: "values.principle1Desc" },
  { icon: "bar-chart", titleKey: "values.principle2Title", descKey: "values.principle2Desc" },
  { icon: "map-pin",   titleKey: "values.principle3Title", descKey: "values.principle3Desc" },
  { icon: "handshake", titleKey: "values.principle4Title", descKey: "values.principle4Desc" },
] as const;

const icons: Record<string, string> = {
  "scale": '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  "bar-chart": '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
  "map-pin": '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
  "handshake": '<path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/>',
};
---
<section class="py-12 lg:py-16 bg-muted/50">
  <div class="section-container">
    <SectionHeader lang={lang} labelKey="values.principlesLabel" titleKey="values.principlesTitle" />
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {principles.map((p, i) => (
        <Reveal variant={i % 2 === 0 ? "left" : "right"} delay={i * 100} class="group flex gap-5 bg-card rounded-xl p-6 lg:p-7 border border-border hover:border-primary/20 hover:shadow-lg transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:scale-105 transition-all duration-300">
            <svg class="text-primary group-hover:text-white transition-colors duration-300" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[p.icon]}></svg>
          </div>
          <div>
            <h3 class="font-heading text-lg font-bold text-card-foreground mb-2">
              {t(p.titleKey, lang)}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {t(p.descKey, lang)}
            </p>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>
