---
import TwoColumnTextImage from "@/components/TwoColumnTextImage.astro";
import { t, extractImages, type Lang } from "@/lib/i18n";
import valuesData from "@/data/translations/values.json";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const imgs = extractImages(valuesData);
---
<TwoColumnTextImage
  lang={lang}
  labelKey="values.introLabel"
  titleKey="values.introTitle1"
  highlightKey="values.introHighlight"
  descriptions={["values.introDesc1", "values.introDesc2"]}
  imageUrl={imgs._img_introImage}
  imageAlt="AfricTivistes - Nos valeurs en action"
>
  <div
    slot="badge"
    class="a-reveal-scale absolute -bottom-6 -left-6 bg-card rounded-xl p-4 shadow-xl border border-border"
    style="--a-delay:300ms"
  >
    <div class="text-3xl font-bold font-heading text-primary">10+</div>
    <div class="text-xs text-muted-foreground font-medium uppercase tracking-wider">
      {t("history.stat3Label", lang)}
    </div>
  </div>
</TwoColumnTextImage>
