---
import Reveal from "@/components/astro/Reveal.astro";
import { t, type Lang } from "@/lib/i18n";

interface Props {
  lang: Lang;
  titleKey: string;
  descKey: string;
  btnKey: string;
  linkTo: string;
  showDecoShapes?: boolean;
  gradientFrom?: string;
  gradientTo?: string;
}

const {
  lang,
  titleKey,
  descKey,
  btnKey,
  linkTo,
  showDecoShapes = false,
  gradientFrom,
  gradientTo,
} = Astro.props;

const href = linkTo.startsWith("/") && !linkTo.startsWith(`/${lang}/`)
  ? `/${lang}${linkTo}`
  : linkTo;
---
<section class="py-20">
  <div class="section-container">
    <Reveal class="relative rounded-2xl overflow-hidden">
      {gradientFrom && gradientTo ? (
        <>
          <div class={`absolute inset-0 bg-gradient-to-br ${gradientFrom} ${gradientTo}`}></div>
          <div class="absolute inset-0 bg-black/40"></div>
        </>
      ) : (
        <div class="absolute inset-0 hero-gradient"></div>
      )}
      <div class="absolute inset-0 pattern-kente opacity-10"></div>
      {showDecoShapes && (
        <>
          <div class="absolute top-8 right-12 w-24 h-24 border border-white/10 rounded-full hidden lg:block"></div>
          <div class="absolute bottom-8 left-16 w-16 h-16 border border-white/20 rounded-xl rotate-45 hidden lg:block"></div>
        </>
      )}
      <div class="relative z-10 px-8 py-16 lg:px-16 lg:py-20 text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
          {t(titleKey, lang)}
        </h2>
        <p class="text-white/85 text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
          {t(descKey, lang)}
        </p>
        <a
          href={href}
          class="inline-flex items-center gap-2 rounded-lg bg-white/15 border border-white/30 backdrop-blur-sm px-8 py-3.5 text-sm font-bold text-white hover:bg-white/25 transition-colors focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2"
        >
          {t(btnKey, lang)}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </Reveal>
  </div>
</section>
