---
import Reveal from "@/components/astro/Reveal.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { t, type Lang } from "@/lib/i18n";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const items = [
  { icon: "target", titleKey: "about.val1Title", descKey: "about.val1Desc" },
  { icon: "heart",  titleKey: "about.val2Title", descKey: "about.val2Desc" },
  { icon: "users",  titleKey: "about.val3Title", descKey: "about.val3Desc" },
  { icon: "globe",  titleKey: "about.val4Title", descKey: "about.val4Desc" },
];

const icons: Record<string, string> = {
  "target": '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  "heart": '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  "users": '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  "globe": '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
};
---
<section class="py-12 lg:py-16 bg-muted/50">
  <div class="section-container">
    <SectionHeader lang={lang} labelKey="about.valuesTitle" titleKey="about.valuesSubtitle" />
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {items.map((v, i) => (
        <Reveal delay={i * 100} class="bg-card rounded-xl p-7 border border-border text-center hover:border-primary/20 hover:shadow-lg transition-all group">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-5 group-hover:bg-primary/20 transition-colors">
            <svg class="text-primary" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[v.icon]}></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-card-foreground mb-3">{t(v.titleKey, lang)}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{t(v.descKey, lang)}</p>
        </Reveal>
      ))}
    </div>
  </div>
</section>
